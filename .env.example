# Local environment configuration — DO NOT COMMIT REAL SECRETS.
# Copy this file to `.env` and fill in your values.

# Application environment: development | testing | production
APP_ENV=development

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database connection (defaults to a local SQLite file for development).
# For Docker compose the DATABASE_URL below is overridden in compose file.
DATABASE_URL=postgresql://aica:aica_secret@localhost:5432/aica

# PostgreSQL credentials (used by docker-compose.yml).
POSTGRES_USER=aica
POSTGRES_PASSWORD=aica_secret
POSTGRES_DB=aica

# Session lifetime in seconds (default: 12 hours).
SESSION_LIFETIME=43200

# LLM provider backend: "mock" (offline, default), "openai", or "anthropic".
# Providers are resolved from a registry (see app/services/providers/).
LLM_PROVIDER=mock

# LLM resilience: retry transient provider failures (network errors, HTTP
# 429/5xx) with exponential backoff plus jitter. Non-transient errors (401/400)
# fail fast. LLM_MAX_RETRIES is the number of retries after the initial attempt.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8.0

# LLM response cache (issue #18): serve identical non-streaming completions from
# memory instead of calling the provider again. Scoped per user; entries expire
# after LLM_CACHE_TTL seconds and the store keeps at most LLM_CACHE_MAX_ENTRIES.
LLM_CACHE_ENABLED=1
LLM_CACHE_TTL=300
LLM_CACHE_MAX_ENTRIES=256

# Display currency for cost estimates (Phase 10, issue #441). Costs are always
# estimates, so every figure shows the currency code explicitly. Keep the
# configured estimate/price rates in this currency when overriding the default.
CURRENCY_CODE=USD
CURRENCY_SYMBOL=$
CURRENCY_DECIMAL_PLACES=4

# Usage ledger, budgets, and billing reconciliation (Phase 10, issues #437-#443,
# #452, #455). The ledger stores metadata only (tokens/cost, no prompts or
# completions). Rows older than USAGE_RETENTION_DAYS may be removed with
# `flask usage purge`; `flask usage backfill` imports historical messages.
USAGE_RETENTION_DAYS=365
# Hard row cap for GET /api/usage/export.csv (may be lowered, never raised above
# the service's 5000-row ceiling). Truncated exports advertise
# X-Export-Truncated: true.
USAGE_EXPORT_CSV_MAX_ROWS=5000
# Fallback estimate rate used when reconciling historical tokens against a
# provider invoice (billing reconciliation only).
LLM_ESTIMATE_USD_PER_1K_TOKENS=0.002
# Optional model for pre-flight estimates. When set, the provider/model price
# table below is used; otherwise the fallback rate above applies.
LLM_MODEL=
# Optional JSON overlay for the provider/model price table (Phase 10, #367/#438).
# Entries not listed keep the safe defaults. Invalid JSON or rates are logged and
# ignored at startup (PRICE_TABLE_ERROR), never breaking requests. Example:
# LLM_PRICE_TABLE={"openai/gpt-4o":{"input_per_1k_usd":0.0025,"output_per_1k_usd":0.01}}
LLM_PRICE_TABLE=
# Budget enforcement runs before every LLM call. A blocked call returns 429
# (fail closed); a budget-evaluation error returns 503. BUDGET_DEFAULT_WARN_THRESHOLD
# is applied to new budgets and must be > 0 and <= 1.
BUDGET_ENFORCEMENT_ENABLED=1
BUDGET_DEFAULT_WARN_THRESHOLD=0.8
# Bounded provider-billing CSV import used by POST /billing/import.
BILLING_IMPORT_MAX_BYTES=1048576
BILLING_IMPORT_MAX_ROWS=5000

# Prometheus metrics (Phase 10, issue #370). METRICS_ENABLED=0 hides /metrics
# entirely (404). Set METRICS_TOKEN to require
# "Authorization: Bearer <token>" from scrapers; when it is empty, only an
# authenticated site-admin session may read the endpoint. Token/cost counters
# are updated from the usage ledger, and label cardinality is capped.
METRICS_ENABLED=1
METRICS_TOKEN=

# Plugin marketplace, catalog, network, and execution settings (Phase 8-9).
# Defaults are intentionally fail-closed: remote installation is disabled, no
# plugin hosts are reachable, and all callbacks are time-bounded.

# Publisher trust. "if-present" accepts unsigned plugins but still refuses a
# forged or untrusted signature; set "required" to also refuse unsigned ones.
# PLUGIN_TRUSTED_KEYS is a JSON object mapping canonical publisher ids to
# Ed25519 public keys (base64 raw 32 bytes or PEM SubjectPublicKeyInfo). Invalid
# key material aborts startup instead of silently disabling verification.
PLUGIN_TRUST_POLICY=if-present
PLUGIN_TRUSTED_KEYS={}

# Operator-controlled catalog for POST .../plugins/install-from-catalog
# (Phase 9, issue #389). Empty disables remote installation. The file is a JSON
# catalog of validated entries: id, version, https source, sha256 integrity,
# optional detached Ed25519 signature, and a full manifest. See docs/plugins.md.
# The catalog is re-read on each install request; no cache TTL setting is active
# yet (catalog caching is tracked in #377).
PLUGIN_CATALOG_FILE=

# Read-only marketplace discovery API (Phase 9, issue #360). The catalog is
# untrusted metadata: entries are validated against plugins/plugin.schema.json
# and are never executed or used to grant capabilities. The default file ships
# empty, so the offline default advertises nothing. Set it to a local JSON
# catalog, or leave it empty and configure PLUGIN_MARKETPLACE_URL for an
# allowlisted remote document.
PLUGIN_MARKETPLACE_ENABLED=1
PLUGIN_MARKETPLACE_CATALOG=plugins/marketplace.json

# Optional remote marketplace document (Phase 9, issues #375/#360). Used only
# when no local marketplace catalog is configured. The URL must be https and its
# host must appear in PLUGIN_NETWORK_ALLOWLIST; the fetch uses the plugin network
# policy's timeout and size cap, refuses redirects, and performs no request
# until those checks pass. Empty disables remote catalog fetching.
PLUGIN_MARKETPLACE_URL=

# Read-only plugin discovery directory used by GET /plugins/discover. It is
# scanned for manifest.json files only; nothing is installed or executed.
PLUGIN_DISCOVERY_DIR=plugins

# Plugin execution budget (Phase 9, issue #408): seconds an event handler or
# lifecycle hook may run before it is abandoned (daemon thread), recorded as a
# bounded error report, and dispatch continues. 0 disables the bound.
PLUGIN_EXECUTION_TIMEOUT=5

# Plugin resource limits (Phase 9, issue #409). These bound the data a plugin
# may persist and the number of error reports an owner can read. Invalid or
# non-positive values fall back to these safe defaults instead of disabling the
# bound. The execution timeout above is the fourth bound.
PLUGIN_CONFIG_MAX_BYTES=65536
PLUGIN_CONFIG_MAX_KEYS=200
PLUGIN_CONFIG_MAX_DEPTH=8
# Owner-scoped error-report read limit (hard ceiling: 500).
PLUGIN_ERROR_REPORT_LIMIT=100

# Plugin outbound network policy (Phase 8, issue #193). Plugin code must make
# requests through app.services.plugin_network; the guard is https-only, denies
# private/loopback/link-local/reserved targets by default, and only reaches
# hosts on the allowlist. An EMPTY allowlist denies every plugin request (fail
# closed). Use "*" to allow any public host or "*.example.com" for subdomains.
PLUGIN_NETWORK_ALLOWLIST=
PLUGIN_NETWORK_HTTPS_ONLY=1
PLUGIN_NETWORK_ALLOW_PRIVATE=0
PLUGIN_NETWORK_TIMEOUT=15
PLUGIN_NETWORK_MAX_BYTES=2097152
PLUGIN_NETWORK_STRICT_DNS=0

# OpenAI-compatible provider settings (only needed when LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# Anthropic Messages API settings (only needed when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024

# Prompt library (Phase 3): how long a deleted prompt's version history is kept
# before it is purged (days).
PROMPT_VERSION_RETENTION_DAYS=30

# User-supplied LLM provider API keys (e.g. OpenAI/Anthropic) are encrypted at
# rest with AES-256-GCM using a key derived from SECRET_KEY (no separate secret
# to provision). Rotating SECRET_KEY invalidates stored keys: to rotate safely,
# re-enter the keys (or re-encrypt with the old secret still configured) after
# switching. No plaintext key is ever written to the database or logs.

# Maximum size of an uploaded file in bytes (default: 16 MB).
MAX_CONTENT_LENGTH=16777216

# GitHub OAuth integration (Phase 4).
# Create an OAuth App at https://github.com/settings/applications/new
#   Homepage URL:  http://localhost:5000
#   Callback URL:  http://localhost:5000/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave blank to use the app's own callback URL automatically.
GITHUB_REDIRECT_URI=
# Optional overrides (defaults shown):
GITHUB_API_URL=https://api.github.com
GITHUB_SCOPES=read:user repo
GITHUB_REQUEST_TIMEOUT=30
GITHUB_MAX_CONTEXT_CHARS=40000
# Show a low-quota warning on the GitHub dashboard when the remaining core API
# budget drops to or below this value (issue #77).
GITHUB_LOW_QUOTA_THRESHOLD=100
# Throttle repeated callback failures for the same user/IP to blunt brute-force
# state probing. Only failures count and a successful connect clears the bucket,
# so legitimate connects are never affected. Defaults shown.
RATE_LIMIT_OAUTH_CALLBACK_MAX=10
RATE_LIMIT_OAUTH_CALLBACK_WINDOW=300

# AI Workspaces & Project Intelligence (Phase 5).
# Limits that protect the server from large or malicious project imports.
# Archive validation (path traversal, symlinks, size and file-count caps) happens
# during extraction; only bounded, sanitized metadata + text content is stored.
PROJECT_MAX_ARCHIVE_BYTES=52428800
PROJECT_MAX_SIZE_BYTES=524288000
PROJECT_MAX_FILE_COUNT=20000
PROJECT_MAX_FILE_CHARS=200000
PROJECT_MAX_CONTEXT_CHARS=40000
PROJECT_SEARCH_MAX_RESULTS=100
PROJECT_GITHUB_MAX_FILES=1000
# Snapshot export (#107): caps the text size of each .PLACEHOLDER.txt stub
# written for binary/oversized files in a downloaded zip snapshot.
PROJECT_EXPORT_PLACEHOLDER_MAX_CHARS=20000
# Run project imports in an in-process background worker (#89): the request
# returns immediately with the project in "indexing" status and the client polls
# `progress` (0-100). Set to 0 to index synchronously (used by tests).
IMPORT_JOBS_ASYNC=1
# Comma-separated directory basenames always skipped during import.
PROJECT_SKIP_DIRS=.git,.hg,.svn,node_modules,.venv,venv,__pycache__,.next,.cache,dist,build,vendor,.tox,.mypy_cache,.pytest_cache
# Comma-separated file basenames / dotfile prefixes always skipped during import.
PROJECT_SKIP_SECRET_FILES=.env,.pem,.key,.p12,.pfx,id_rsa,id_ed25519,id_dsa,credentials,.htpasswd,.npmrc,.pypirc,secrets.yaml,secret.yaml,secret.yml

# AI Code Review & Quality Tooling (Phase 6).
# See docs/reviews.md for the Reviews pages, the finding vocabulary, and the
# review API. A review never sends more than REVIEW_MAX_CONTEXT_CHARS of
# repository text to the model, and never analyzes more than REVIEW_MAX_FILES
# changed files; the model is capped at REVIEW_MAX_FINDINGS findings per review.
REVIEW_MAX_FILES=40
REVIEW_MAX_CONTEXT_CHARS=40000
REVIEW_MAX_FINDINGS=100
# Comma-separated project review kinds offered by default.
REVIEW_KINDS=quality,security,tests
# Minimum finding severity stored for project reviews (critical/high/medium/low).
REVIEW_SEVERITY_THRESHOLD=low

# Team Collaboration (Phase 7).
# Default invitation validity in hours (default: 168 = 7 days).
INVITE_TTL_HOURS=168
# Maximum workspace members included in AI team context per project chat.
PROJECT_MAX_MEMBER_CONTEXT=20
# In-memory rate limits for public collaboration endpoints + presence heartbeat.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=300
# Per-user sliding-window limits for the costly Phase 5 endpoints (issue #106):
# import, search, chat, chat-stream, and analyze. Each pair is
# <max requests> per <window seconds>, keyed by user id. Excess requests get a
# 429 response with a Retry-After header.
RATE_LIMIT_IMPORT_MAX=10
RATE_LIMIT_IMPORT_WINDOW=3600
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_SEARCH_WINDOW=60
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_STREAM_MAX=30
RATE_LIMIT_STREAM_WINDOW=60
RATE_LIMIT_ANALYZE_MAX=20
RATE_LIMIT_ANALYZE_WINDOW=300
# Snapshot export (#107): exports build a zip in memory, so they get a tight
# per-user limit of their own (requests per window seconds).
RATE_LIMIT_EXPORT_MAX=10
RATE_LIMIT_EXPORT_WINDOW=3600
# Per-user rate limit for AI-powered endpoints (/chat conversations and the
# /tools/* code helpers). Requests and window are per authenticated user (not
# per IP); set RATE_LIMIT_AI_ENABLED=0 to switch the limit off entirely.
RATE_LIMIT_AI_PER_MINUTE=60
RATE_LIMIT_AI_WINDOW=60
RATE_LIMIT_AI_ENABLED=1

# Prometheus metrics (Phase 10, issue #370). METRICS_ENABLED=0 hides /metrics
# entirely (404). Set METRICS_TOKEN to require
# "Authorization: Bearer <token>" from scrapers; when it is empty, only an
# authenticated site-admin session may read the endpoint. Token/cost counters
# are updated from the usage ledger, and label cardinality is capped.
METRICS_ENABLED=1
METRICS_TOKEN=
# Optional SMTP for invitation emails. When unset, invitations are delivered as
# in-app notifications only (never crashes a request on mail failure).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=1

# Stellar / Soroban integration (Phase 8).
# Default network used by the Stellar service: mainnet | testnet | futurenet | custom.
# Testnet is the default so nothing touches real XLM unless explicitly configured.
STELLAR_NETWORK=testnet
# Optional explicit Horizon / Soroban RPC endpoints. Leave blank to use the
# built-in presets for STELLAR_NETWORK, or point at a local stellar-core /
# soroban-rpc instance during development.
STELLAR_HORIZON_URL=
STELLAR_RPC_URL=
# Request timeout (seconds) and response-body cap for outbound Stellar calls.
STELLAR_REQUEST_TIMEOUT=15
STELLAR_MAX_RESPONSE_BYTES=2097152
# Maximum ledger keys accepted per Soroban RPC getLedgerEntries call.
STELLAR_RPC_MAX_KEYS=100
# Verify public-network endpoints resolve to a globally routable address (DNS)
# before each request. Keep enabled; disable only for isolated networks.
STELLAR_STRICT_HOST_VALIDATION=1
